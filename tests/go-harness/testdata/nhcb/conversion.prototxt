name: "float_unsorted"
help: "Float counts, unsorted and repeated bounds, no +Inf bucket."
type: GAUGE_HISTOGRAM
metric: <
  label: < name: "job" value: "a" >
  histogram: <
    sample_count_float: 7.5
    sample_sum: 12.25
    bucket: < cumulative_count_float: 2.5 upper_bound: 1 >
    bucket: < cumulative_count_float: 0.5 upper_bound: -inf >
    bucket: < cumulative_count_float: 2.5 upper_bound: 1 >
    bucket: < cumulative_count_float: 7.5 upper_bound: 10
      exemplar: < label: < name: "id" value: "x" > value: 9 timestamp: < seconds: 1625851153 nanos: 146848499 > >
    >
    bucket: < cumulative_count_float: 7.5 upper_bound: 20 >
    start_timestamp: < seconds: 1625851100 >
  >
  timestamp_ms: 1234568
>
---
name: "int_empty_runs"
help: "Leading, short, long, and trailing runs of empty buckets."
type: HISTOGRAM
metric: <
  histogram: <
    sample_count: 9
    sample_sum: 40
    bucket: < cumulative_count: 0 upper_bound: 0.5 >
    bucket: < cumulative_count: 2 upper_bound: 1 >
    bucket: < cumulative_count: 2 upper_bound: 2 >
    bucket: < cumulative_count: 2 upper_bound: 3 >
    bucket: < cumulative_count: 4 upper_bound: 4 >
    bucket: < cumulative_count: 4 upper_bound: 5 >
    bucket: < cumulative_count: 4 upper_bound: 6 >
    bucket: < cumulative_count: 4 upper_bound: 7 >
    bucket: < cumulative_count: 9 upper_bound: 8 >
    bucket: < cumulative_count: 9 upper_bound: 9 >
    bucket: < cumulative_count: 9 upper_bound: inf >
    bucket: < cumulative_count: 9 upper_bound: 11 >
  >
>
metric: <
  label: < name: "empty" value: "histogram" >
  histogram: < >
>
metric: <
  label: < name: "missing" value: "histogram" >
>
---
name: "float_empty_buckets"
help: "Float counts with empty buckets, compacted without gaps."
type: HISTOGRAM
metric: <
  histogram: <
    sample_count_float: 3.5
    sample_sum: 1
    bucket: < cumulative_count_float: 1.5 upper_bound: 1 >
    bucket: < cumulative_count_float: 1.5 upper_bound: 2 >
    bucket: < cumulative_count_float: 3.5 upper_bound: 3 >
  >
>
---
name: "mixed"
help: "Native and classic histograms in one family."
type: HISTOGRAM
metric: <
  label: < name: "kind" value: "native" >
  histogram: <
    sample_count: 2
    sample_sum: 3
    schema: 0
    zero_threshold: 0.001
    positive_span: < offset: 0 length: 1 >
    positive_delta: 2
    bucket: < cumulative_count: 2 upper_bound: 5
      exemplar: < label: < name: "id" value: "native" > value: 1 timestamp: < seconds: 1 > >
    >
  >
>
metric: <
  label: < name: "kind" value: "classic" >
  histogram: <
    sample_count: 2
    sample_sum: 3
    bucket: < cumulative_count: 1 upper_bound: 1
      exemplar: < label: < name: "id" value: "no-timestamp" > value: 1 >
    >
    bucket: < cumulative_count: 2 upper_bound: 5
      exemplar: < label: < name: "id" value: "classic" > value: 4 timestamp: < seconds: 2 > >
    >
  >
>
metric: <
  label: < name: "kind" value: "native-again" >
  histogram: <
    sample_count: 1
    sample_sum: 1
    schema: 0
    zero_threshold: 0.001
    zero_count: 1
  >
>
metric: <
  label: < name: "kind" value: "float-native" >
  histogram: <
    sample_count_float: 3.5
    sample_sum: 2
    schema: 0
    zero_threshold: 0.001
    positive_span: < offset: 0 length: 1 >
    positive_count: 1.5
    negative_span: < offset: 1 length: 1 >
    negative_count: 2
  >
>
metric: <
  label: < name: "kind" value: "float-classic" >
  histogram: <
    sample_count_float: 2.5
    sample_sum: 3
    bucket: < cumulative_count_float: 1.5 upper_bound: 1 >
    bucket: < cumulative_count_float: 2.5 upper_bound: 5 >
  >
>
metric: <
  label: < name: "kind" value: "float-native-again" >
  histogram: <
    sample_count_float: 1.5
    sample_sum: 1
    schema: 0
    zero_threshold: 0.001
    zero_count_float: 1.5
  >
>
---
name: "float_nan_count"
help: "A NaN cumulative count followed by a finite one."
type: HISTOGRAM
metric: <
  histogram: <
    sample_count_float: 3.5
    sample_sum: 1
    bucket: < cumulative_count_float: nan upper_bound: 1 >
    bucket: < cumulative_count_float: 2.5 upper_bound: 2 >
  >
>
